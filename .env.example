# =============================================================================
# Supernova (nova) — Ortam Değişkenleri Şablonu
# =============================================================================
# Bu dosyayı `.env` olarak kopyalayın ve GERÇEK değerleri girin.
# `.env` asla commit edilmez (.gitignore). Üretimde secret'ları bir secret
# manager / CI secret vault'tan enjekte edin (NIS2 Art.21(1)(h); ISO A.8.24).
#
# Güçlü rastgele değerler üretmek için:
#   python3 scripts/generate_secret.py
# =============================================================================

# --- Çalışma modu -----------------------------------------------------------
# development | staging | production
# production: Config.validate() eksik/zayıf secret veya DEBUG=True'da fail-fast.
NOVA_ENV=development

# --- Kriptografik anahtarlar (ZORUNLU üretimde) -----------------------------
# Token imzalama (HMAC-SHA256). En az 32 bayt (44 karakter url-safe base64).
NOVA_HMAC_SECRET=__RUN_python3_scripts_generate_secret_py__

# Flask oturum/uygulama anahtarı. En az 32 bayt.
NOVA_FLASK_SECRET=__RUN_python3_scripts_generate_secret_py__

# Datasource kimlik bilgilerinin DB'de şifrelenmesi (Fernet, AES-128-CBC+HMAC).
# `python3 scripts/generate_secret.py --fernet` ile üretilebilir (base64 32 bayt).
NOVA_DATA_SECRETS_KEY=__RUN_python3_scripts_generate_secret_py___fernet__

# (Opsiyonel) Argon2 şifre hash için ek peper. Boşsa peper kullanılmaz.
# NOVA_ARGON2_PEPPER=

# --- Ağ / proxy -------------------------------------------------------------
# Frontend kökenleri (virgülle ayrılmış, joker yok). CORS allowlist.
NOVA_CORS_ORIGINS=http://localhost:4201,http://127.0.0.1:4201

# Reverse proxy arkasında bağlanma adresi (gunicorn). 127.0.0.1 önerilir.
NOVA_BIND_HOST=127.0.0.1
NOVA_BIND_PORT=5001

# Güvenilir proxy hop sayısı (ProxyFix için). Tek nginx arkasında 1.
NOVA_TRUSTED_PROXY_HOPS=1

# HSTS (yalnızca TLS arkasında anlamlı). production'da açın.
NOVA_HSTS_ENABLED=false
NOVA_HSTS_MAX_AGE=31536000

# --- Oturum / token ---------------------------------------------------------
# Erişim token ömrü (saniye). Kısa tutulur (15 dk = 900).
NOVA_TOKEN_ACCESS_TTL=900
# Refresh token ömrü (saniye). 8 saat = 28800.
NOVA_TOKEN_REFRESH_TTL=28800

# --- Şifre politikası -------------------------------------------------------
NOVA_PASSWORD_MIN_LENGTH=12
# Yaygın şifre denylist dosyası (opsiyonel, satır başına bir şifre).
# NOVA_PASSWORD_DENYLIST=supernova-backend/common_passwords.txt

# --- Rate limiting ----------------------------------------------------------
# storage URI: development -> memory:// (worker başına ayrı sayar),
#              production -> redis://host:6379/nova (paylaşımlı — zorunlu).
NOVA_RATELIMIT_STORAGE_URI=memory://
# Tüm uç noktalar: IP başına dakika (DoS tabanı).
NOVA_RATELIMIT_GLOBAL_PER_MIN=300
# /api/auth/login: IP başına dakika (kaba kuvvet tabanı).
NOVA_RATELIMIT_LOGIN_PER_MIN=10
# Login kaba kuvvet: pencere başına max deneme.
NOVA_LOGIN_MAX_ATTEMPTS=5
NOVA_LOGIN_WINDOW_SECONDS=300
NOVA_LOGIN_LOCKOUT_SECONDS=900

# --- Denetim (audit) logu ---------------------------------------------------
# Audit kayıtlarının saklanma süresi (gün). 0 = sonsuz.
NOVA_AUDIT_LOG_RETENTION_DAYS=365

# --- Yedekleme (scripts/backup_db.sh) ---------------------------------------
# NIS2 Art.21(1)(c) business continuity. Çevrimiçi tutarlı anlık görüntü →
# gzip → gpg AES256 simetrik (parola fd üzerinden, ps'te görünmez).
# NOVA_BACKUP_DB=db/supernova_reports.db   # yedeklenecek SQLite yolu
# NOVA_BACKUP_PASSPHRASE=                   # simetrik şifre parolası (vault'tan) — ZORUNLU
# NOVA_BACKUP_DIR=                          # çıktı dizini (varsayılan: ./backups)
# NOVA_BACKUP_KEEP=14                       # tutulacak yedek sayısı
# Kurtarma: gpg --decrypt nova_*.db.gz.gpg | gunzip > restored.db

# --- Sandbox (Python Workspace) --------------------------------------------
# (Opsiyonel) Sandbox'ı ayrı OS kullanıcısı altında çalıştırma (defense-in-depth).
# NOVA_SANDBOX_USER=nova-sandbox

# --- Genel DB konfigürasyonu (şu an SQLite app DB; ileride harici için) -----
# NOVA_DB_USER=
# NOVA_DB_PASSWORD=
# NOVA_DB_HOST=
# NOVA_DB_PORT=
# Optional offline AI Copilot (application works normally when disabled)
AI_ENABLED=false
AI_PROVIDER=openai
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL_NAME=qwen3.5:9b
AI_API_KEY=
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=2048
AI_MAX_CONCURRENT=2
AI_MEMORY_ENABLED=true
AI_TOOLS_ENABLED=true
AI_MOCK_MODE=false
# Optional Apple Silicon profile using already cached Qwen3.5 MLX weights:
# python3 scripts/local_ai.py configure  (opt-in, only updates local AI settings)
# python3 scripts/local_ai.py serve      (separate process; never launched by core)
# python3 scripts/local_ai.py disable    (AI_ENABLED=false; restart backend)
